{
  "crons": [
    { "path": "/api/news-ingest", "schedule": "0 13 * * *" }
  ],
  "functions": {
    "api/extract-bill.js": {
      "maxDuration": 30
    },
    "api/news-ingest.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
